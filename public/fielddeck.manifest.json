{
  "schema_version": "0.8.0",
  "name": "FieldDeck",
  "description": "Public discovery only; no execution rights conferred.",
  "execution_policy": {
    "default": "deny",
    "require_authenticated_runner": true,
    "freeform_shell": false,
    "receipt_required": true
  },
  "actions": [
    {
      "id": "catalog-health",
      "label": "Catalog Health",
      "description": "Validate the action registry and governance invariants.",
      "group": "Diagnostics",
      "icon": "activity",
      "kind": "workflow",
      "task": "catalog-health",
      "status": "ready",
      "risk": "low"
    },
    {
      "id": "script-smoke",
      "label": "Script Smoke Test",
      "description": "Run a deterministic, network-free Python test in GitHub Actions.",
      "group": "Scripts",
      "icon": "terminal",
      "kind": "workflow",
      "task": "script-smoke",
      "status": "ready",
      "risk": "low"
    },
    {
      "id": "macro-demo",
      "label": "Macro Sequence",
      "description": "Run three fixed sample steps and publish a JSON receipt.",
      "group": "Macros",
      "icon": "mouse-pointer-click",
      "kind": "workflow",
      "task": "macro-demo",
      "status": "ready",
      "risk": "low"
    },
    {
      "id": "copy-research",
      "label": "Research Skill",
      "description": "Copy an evidence-first research instruction for an assistant.",
      "group": "Skills",
      "icon": "brain-circuit",
      "kind": "copy",
      "payload": "Research the topic using reliable sources. Separate observations from hypotheses. Include citations, uncertainty, counterevidence, and a reproducible evidence ledger.",
      "status": "ready",
      "risk": "low"
    },
    {
      "id": "export-catalog",
      "label": "Export Catalog",
      "description": "Download the complete machine-readable catalog.",
      "group": "Agents",
      "icon": "download",
      "kind": "export",
      "status": "ready",
      "risk": "low"
    },
    {
      "id": "open-vessel",
      "label": "Open SuperPhiVessel",
      "description": "Open SuperPhiVessel in a new tab.",
      "group": "Apps",
      "icon": "external-link",
      "kind": "link",
      "url": "https://superphivessel.netlify.app/",
      "status": "ready",
      "risk": "low"
    },
    {
      "id": "agent-intake",
      "label": "Agent Intake",
      "description": "Planned authenticated action request endpoint.",
      "group": "Agents",
      "icon": "bot",
      "kind": "future",
      "status": "locked",
      "risk": "medium"
    },
    {
      "id": "local-runner",
      "label": "Paired Local Runner",
      "description": "Planned securely paired runner for supervised local scripts.",
      "group": "Macros",
      "icon": "hard-drive",
      "kind": "future",
      "status": "locked",
      "risk": "high"
    },
    {
      "id": "memory-sync",
      "label": "NBG Memory Sync",
      "description": "Planned governed memory operations for NestedBubbleGear and PhiOS.",
      "group": "Skills",
      "icon": "database",
      "kind": "future",
      "status": "locked",
      "risk": "high"
    },
    {
      "id": "field-health-sweep",
      "label": "Field Health Sweep",
      "description": "Run a fixed three-step chain through GitHub IssueOps, with per-step receipts.",
      "group": "Automations",
      "icon": "list-checks",
      "kind": "workflow",
      "task": "field-health-sweep",
      "status": "ready",
      "risk": "low"
    },
    {
      "id": "scheduled-chain",
      "label": "Scheduled Chain",
      "description": "Planned versioned schedule and automation support.",
      "group": "Automations",
      "icon": "clock-3",
      "kind": "future",
      "status": "locked",
      "risk": "medium"
    }
  ],
  "request_protocol": {
    "type": "github_issue",
    "version": "v0.2",
    "confirmation_required": true,
    "required_repository_permission": "write",
    "title_pattern": "FD RUN: {task}",
    "request_marker_pattern": "<!-- fielddeck:run:v0.2:{task} -->",
    "workflow_file": ".github/workflows/issueops.yml",
    "receipt": "github_actions_artifact_and_issue_comment",
    "execution_mode": "authenticated-human-or-agent-request-only"
  },
  "view_protocol": {
    "version": "v0.3",
    "personal_decks": "localStorage-only",
    "execution_history": "public-github-actions-readonly",
    "discovery_grants_authority": false
  },
  "chain_protocol": {
    "version": "v0.4",
    "drafts": "localStorage-only",
    "custom_chains_executable": false,
    "approved_presets": [
      {
        "id": "field-health-sweep",
        "steps": [
          "catalog-health",
          "script-smoke",
          "macro-demo"
        ],
        "requires_request": true,
        "requires_repository_write": true
      }
    ],
    "execution_authority": "GitHub IssueOps permission gate"
  },
  "blueprint_protocol": {
    "version": "v0.5",
    "schema_kind": "fielddeck.chain.blueprint",
    "import_policy": "strict-validate-and-sanitize",
    "max_bytes": 16384,
    "max_steps": 6,
    "preflight": "local-read-only",
    "preflight_receipt": false,
    "custom_blueprints_executable": false,
    "approved_execution_route": "authenticated-github-issueops"
  },
  "proposal_protocol": {
    "version": "v0.6",
    "kind": "fielddeck.chain.blueprint",
    "request_route": "github_issue",
    "issue_title": "FD PROPOSE: {blueprint_name}",
    "validation_workflow": ".github/workflows/blueprint-review.yml",
    "human_review_required": true,
    "proposal_issues_public": true,
    "automatic_promotion": false,
    "execution_authorized": false,
    "review_outcomes": [
      "VALID_FOR_REVIEW",
      "REJECTED"
    ]
  },
  "review_board_protocol": {
    "version": "v0.7",
    "inbox": "public-github-issues-readonly",
    "validation_evidence": "github-actions-bot-comment",
    "decision_route": "github-issue-comment",
    "decision_commands": [
      "accept",
      "decline"
    ],
    "required_review_permission": "write",
    "fingerprint_required": true,
    "automatic_execution": false,
    "automatic_implementation": false,
    "approval_source_of_truth": "trusted-github-workflow-artifact"
  },
  "review_evidence_protocol": {
    "version": "v0.8",
    "current_issue_revalidation": true,
    "public_comments_scanned_per_request": 100,
    "trusted_comment_author": "github-actions[bot]",
    "fingerprint": "canonical_sha256",
    "accepted_comment_requires_prior_validation": true,
    "reject_stale_validation": true,
    "review_does_not_grant_execution": true,
    "no_auto_implementation": true
  }
}
